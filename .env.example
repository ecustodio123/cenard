# Canonical origin is fixed to the confirmed domain https://cenardarbitraje.com.
# Production builds are indexable. Use false for staging or shared previews.
# SITE_INDEXABLE=false
# Cloudflare branches other than PRODUCTION_BRANCH are automatically noindex.
# PRODUCTION_BRANCH=main

# Public read-only Supabase connection; configure these in Cloudflare Pages too.
# Never use secret/service_role keys in browser variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
